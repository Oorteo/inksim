#!/usr/bin/env bash
set -euo pipefail

### call inksim as package via uv, so that it can be run from anywhere,
###      even if the current working directory is not the project root

SOURCE="${BASH_SOURCE[0]}"
# Resolve symlinks portably; this is the Bash equivalent of readlink -f.
while [[ -L "$SOURCE" ]]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" = /* ]] || SOURCE="$SCRIPT_DIR/$SOURCE"
done
SCRIPT_PATH="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)/$(basename "$SOURCE")"
PROJECT_DIR="$(dirname "$SCRIPT_PATH")"

cd "$PROJECT_DIR"
exec uvr python -m inksim "$@"
