  "dialog.about.body": {
    "source": "Explore stitch order, thread colors, jumps, trims, and machine commands before production. Preview the design stitch by stitch, switch rendering styles, and export what you see.",
    "translation": "உற்பத்திக்கு முன் தையல் வரிசை, நூல் நிறங்கள், தாவல்கள், டிரிம்கள் மற்றும் இயந்திர கட்டளைகளை ஆராயுங்கள். வடிவமைப்பை தையல் மூலம் தையல் முன்னோட்டமிடுங்கள், ரெண்டரிங் பாணிகளை மாற்றவும், நீங்கள் பார்ப்பதை ஏற்றுமதி செய்யவும்."
  },
  "dialog.about.last_update_check": {
    "source": "Last update check: {when}",
    "translation": "கடைசி புதுப்பிப்பு சோதனை: {when}"
  },
  "dialog.about.tagline": {
    "source": "Interactive embroidery simulation, inspection, and export.",
    "translation": "ஊடாடும் எம்பிராய்டரி உருவகப்படுத்துதல், ஆய்வு மற்றும் ஏற்றுமதி."
  },
