    "dialog.about.body": {
        "source": "Explore stitch order, thread colors, jumps, trims, and machine commands before production. Preview the design stitch by stitch, switch rendering styles, and export what you see.",
        "translation": "ഉൽപ്പാദനത്തിന് മുമ്പ് സ്റ്റിച്ച് ഓർഡർ, ത്രെഡ് നിറങ്ങൾ, ജമ്പുകൾ, ട്രിമുകൾ, മെഷീൻ കമാൻഡുകൾ എന്നിവ പര്യവേക്ഷണം ചെയ്യുക. ഡിസൈൻ സ്റ്റിച്ച് ബൈ സ്റ്റിച്ച് പ്രിവ്യൂ ചെയ്യുക, റെൻഡറിംഗ് ശൈലികൾ മാറ്റുക, നിങ്ങൾ കാണുന്നത് എക്സ്പോർട്ട് ചെയ്യുക."
    },
    "dialog.about.last_update_check": {
        "source": "Last update check: {when}",
        "translation": "അവസാന അപ്ഡേറ്റ് പരിശോധന: {when}"
    },
    "dialog.about.tagline": {
        "source": "Interactive embroidery simulation, inspection, and export.",
        "translation": "ഇന്ററാക്ടീവ് എംബ്രോയ്ഡറി സിമുലേഷൻ, പരിശോധന, എക്സ്പോർട്ട്."
    },
