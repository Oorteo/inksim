    "dialog.about.body": {
        "source": "Explore stitch order, thread colors, jumps, trims, and machine commands before production. Preview the design stitch by stitch, switch rendering styles, and export what you see.",
        "translation": "Εξερευνήστε τη σειρά των βελονιών, τα χρώματα κλωστής, τα άλματα, τα κοψίματα και τις εντολές μηχανής πριν την παραγωγή. Δείτε το σχέδιο βελονιά-βελονιά, αλλάξτε στυλ απόδοσης και εξάγετε ό,τι βλέπετε."
    },
    "dialog.about.last_update_check": {
        "source": "Last update check: {when}",
        "translation": "Τελευταίος έλεγχος ενημέρωσης: {when}"
    },
