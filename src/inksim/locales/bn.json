    "dialog.about.body": {
        "source": "Explore stitch order, thread colors, jumps, trims, and machine commands before production. Preview the design stitch by stitch, switch rendering styles, and export what you see.",
        "translation": "উৎপাদনের আগে স্টিচ অর্ডার, থ্রেড রং, জাম্প, ট্রিম এবং মেশিন কমান্ড অন্বেষণ করুন। ডিজাইনটি স্টিচে স্টিচে প্রিভিউ করুন, রেন্ডারিং স্টাইল পরিবর্তন করুন এবং যা দেখেন তা রপ্তানি করুন।"
    },
    "dialog.about.last_update_check": {
        "source": "Last update check: {when}",
        "translation": "সর্বশেষ আপডেট পরীক্ষা: {when}"
    },
