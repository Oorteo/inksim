    "dialog.about.body": {
        "source": "Explore stitch order, thread colors, jumps, trims, and machine commands before production. Preview the design stitch by stitch, switch rendering styles, and export what you see.",
        "translation": "Esplora l-ordni tal-ponti, il-kuluri tal-ħajt, il-qbiż, it-trims, u l-kmandi tal-magna qabel il-produzzjoni. Ara l-preview tad-disinn ponti b'ponti, ibdel l-istili tar-rendering, u esporta dak li tara."
    },
    "dialog.about.last_update_check": {
        "source": "Last update check: {when}",
        "translation": "Aħħar kontroll tal-aġġornament: {when}"
    },
