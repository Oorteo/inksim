    "dialog.about.body": {
        "source": "Explore stitch order, thread colors, jumps, trims, and machine commands before production. Preview the design stitch by stitch, switch rendering styles, and export what you see.",
        "translation": "ಉತ್ಪಾದನೆಗೆ ಮೊದಲು ಹೊಲಿಗೆ ಕ್ರಮ, ಥ್ರೆಡ್ ಬಣ್ಣಗಳು, ಜಂಪ್ಗಳು, ಟ್ರಿಮ್ಗಳು ಮತ್ತು ಯಂತ್ರ ಆಜ್ಞೆಗಳನ್ನು ಅನ್ವೇಷಿಸಿ. ವಿನ್ಯಾಸವನ್ನು ಹೊಲಿಗೆ ಹೊಲಿಗೆಯಾಗಿ ಪೂರ್ವವೀಕ್ಷಿಸಿ, ರೆಂಡರಿಂಗ್ ಶೈಲಿಗಳನ್ನು ಬದಲಾಯಿಸಿ ಮತ್ತು ನೀವು ನೋಡುವುದನ್ನು ರಫ್ತು ಮಾಡಿ."
    },
    "dialog.about.last_update_check": {
        "source": "Last update check: {when}",
        "translation": "ಕೊನೆಯ ನವೀಕರಣ ಪರಿಶೀಲನೆ: {when}"
    },
    "dialog.about.tagline": {
        "source": "Interactive embroidery simulation, inspection, and export.",
        "translation": "ಸಂವಾದಾತ್ಮಕ ಕಸೂತಿ ಸಿಮ್ಯುಲೇಶನ್, ಪರಿಶೀಲನೆ ಮತ್ತು ರಫ್ತು."
    },
