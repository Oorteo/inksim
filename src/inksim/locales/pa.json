    "dialog.about.body": {
        "source": "Explore stitch order, thread colors, jumps, trims, and machine commands before production. Preview the design stitch by stitch, switch rendering styles, and export what you see.",
        "translation": "ਉਤਪਾਦਨ ਤੋਂ ਪਹਿਲਾਂ ਸਿਲਾਈ ਕ੍ਰਮ, ਧਾਗੇ ਦੇ ਰੰਗ, ਜੰਪ, ਟ੍ਰਿਮ ਅਤੇ ਮਸ਼ੀਨ ਕਮਾਂਡਾਂ ਦੀ ਪੜਚੋਲ ਕਰੋ। ਡਿਜ਼ਾਈਨ ਨੂੰ ਸਿਲਾਈ ਦਰ ਸਿਲਾਈ ਵੇਖੋ, ਰੈਂਡਰਿੰਗ ਸ਼ੈਲੀਆਂ ਬਦਲੋ, ਅਤੇ ਜੋ ਵੇਖਦੇ ਹੋ ਉਸਨੂੰ ਐਕਸਪੋਰਟ ਕਰੋ।"
    },
    "dialog.about.last_update_check": {
        "source": "Last update check: {when}",
        "translation": "ਆਖਰੀ ਅੱਪਡੇਟ ਜਾਂਚ: {when}"
    },
    "dialog.about.tagline": {
        "source": "Interactive embroidery simulation, inspection, and export.",
        "translation": "ਇੰਟਰਐਕਟਿਵ ਕਢਾਈ ਸਿਮੂਲੇਸ਼ਨ, ਨਿਰੀਖਣ ਅਤੇ ਐਕਸਪੋਰਟ।"
    },
