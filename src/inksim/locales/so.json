    "dialog.about.body": {
        "source": "Explore stitch order, thread colors, jumps, trims, and machine commands before production. Preview the design stitch by stitch, switch rendering styles, and export what you see.",
        "translation": "Sahmi nidaamka tolida, midabada dunta, boodboodka, goynta, iyo amarka mashiinka ka hor wax soo saar. Horudhac u samee naqshadda tol tol, beddel qaababka render-ka, oo dhoofso waxa aad aragto."
    },
    "dialog.about.last_update_check": {
        "source": "Last update check: {when}",
        "translation": "Hubinta cusboonaysiinta ugu dambeysay: {when}"
    },
