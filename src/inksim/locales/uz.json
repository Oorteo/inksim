    "dialog.about.body": {
        "source": "Explore stitch order, thread colors, jumps, trims, and machine commands before production. Preview the design stitch by stitch, switch rendering styles, and export what you see.",
        "translation": "Ishlab chiqarishdan oldin tikuv tartibini, ip ranglarini, o'tishlarni, kesishlarni va mashina buyruqlarini o'rganing. Dizaynni tikuvma-tikuv ko'rib chiqing, render uslublarini almashtiring va ko'rganingizni eksport qiling."
    },
    "dialog.about.last_update_check": {
        "source": "Last update check: {when}",
        "translation": "So'nggi yangilanish tekshiruvi: {when}"
    },
    "dialog.about.tagline": {
        "source": "Interactive embroidery simulation, inspection, and export.",
        "translation": "Interaktiv kashta tikish simulyatsiyasi, tekshirish va eksport."
