    "dialog.about.body": {
        "source": "Explore stitch order, thread colors, jumps, trims, and machine commands before production. Preview the design stitch by stitch, switch rendering styles, and export what you see.",
        "translation": "Chunguza mpangilio wa mishono, rangi za nyuzi, miruko, upunguzaji, na amri za mashine kabla ya uzalishaji. Ona muundo shono kwa shono, badilisha mitindo ya kuonyesha, na hamisha unachokiona."
    },
    "dialog.about.last_update_check": {
        "source": "Last update check: {when}",
        "translation": "Angalia sasisho la mwisho: {when}"
    },
    "dialog.about.tagline": {
        "source": "Interactive embroidery simulation, inspection, and export.",
        "translation": "Uigaji wa mwingiliano wa ushonaji, ukaguzi, na usafirishaji."
    },
